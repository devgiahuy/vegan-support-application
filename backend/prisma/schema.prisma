model RefreshSession {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  tokenHash    String          @unique @map("token_hash") @db.Char(64)
  familyId     String          @map("family_id") @db.Uuid
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?         @map("revoke_reason") @db.VarChar(50)
  replacedById String?         @unique @map("replaced_by_id") @db.Uuid
  deviceInfo   String?         @map("device_info") @db.VarChar(500)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime?       @map("last_used_at") @db.Timestamptz(3)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshSession? @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshSession? @relation("SessionReplacement")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

model ContributorApplication {
  id                   String                       @id @default(uuid()) @db.Uuid
  userId               String                       @map("user_id") @db.Uuid
  claimedApprovalBasis ContributorApprovalBasis     @map("claimed_approval_basis")
  organizationClaim    String?                      @map("organization_claim") @db.VarChar(500)
  experience           String
  referenceLinks       Json                         @default("[]") @map("reference_links")
  source               ContributorApplicationSource @default(REGISTRATION)
  invitedById          String?                      @map("invited_by_id") @db.Uuid
  invitationReason     String?                      @map("invitation_reason") @db.VarChar(2000)
  status               ContributorApplicationStatus @default(PENDING)
  approvalBasis        ContributorApprovalBasis?    @map("approval_basis")
  reviewEvidence       Json?                        @map("review_evidence")
  reviewNote           String?                      @map("review_note") @db.VarChar(2000)
  reviewedById         String?                      @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?                    @map("reviewed_at") @db.Timestamptz(3)
  reapplyEligibleAt    DateTime?                    @map("reapply_eligible_at") @db.Timestamptz(3)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy            User?                        @relation("ContributorApplicationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  reviewedBy           User?                        @relation("ContributorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  contributorProfile   ContributorProfile?
  decisions            ContributorDecision[]

  @@index([status, createdAt, id])
  @@index([claimedApprovalBasis, status, createdAt])
  @@index([userId, createdAt])
  @@index([invitedById, createdAt])
  @@index([reviewedById, reviewedAt])
  @@map("contributor_applications")
}

model ContributorProfile {
  userId              String                   @id @map("user_id") @db.Uuid
  approvalBasis       ContributorApprovalBasis @map("approval_basis")
  approvalEvidence    Json                     @map("approval_evidence")
  approvedAt          DateTime                 @map("approved_at") @db.Timestamptz(3)
  approvedById        String                   @map("approved_by_id") @db.Uuid
  sourceApplicationId String                   @unique @map("source_application_id") @db.Uuid
  revokedAt           DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedById         String?                  @map("revoked_by_id") @db.Uuid
  revocationReason    String?                  @map("revocation_reason") @db.VarChar(2000)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User                     @relation("ContributorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy          User                     @relation("ContributorProfileApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  revokedBy           User?                    @relation("ContributorProfileRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  sourceApplication   ContributorApplication   @relation(fields: [sourceApplicationId], references: [id], onDelete: Restrict)

  @@index([approvalBasis, approvedAt])
  @@index([approvedById, approvedAt])
  @@index([revokedById, revokedAt])
  @@map("contributor_profiles")
}

model ContributorDecision {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  applicationId String?                   @map("application_id") @db.Uuid
  actorId       String                    @map("actor_id") @db.Uuid
  decision      ContributorDecisionType
  approvalBasis ContributorApprovalBasis? @map("approval_basis")
  evidence      Json?
  reason        String                    @db.VarChar(2000)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User                      @relation("ContributorDecisionSubject", fields: [userId], references: [id], onDelete: Restrict)
  application   ContributorApplication?   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor         User                      @relation("ContributorDecisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([applicationId, createdAt])
  @@index([actorId, createdAt])
  @@index([decision, createdAt])
  @@map("contributor_decisions")
}

