generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  CONTRIBUTOR
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  LOCKED
  BANNED
  DELETED

  @@map("user_status")
}

enum ContributorApprovalBasis {
  ORGANIZATION_AFFILIATION
  PLATFORM_TRACK_RECORD
  ADMIN_INVITED

  @@map("contributor_approval_basis")
}

enum ContributorApplicationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("contributor_application_status")
}

enum ContributorApplicationSource {
  REGISTRATION
  PROFILE
  ADMIN_INVITATION

  @@map("contributor_application_source")
}

enum ContributorDecisionType {
  APPROVED
  REJECTED
  REVOKED

  @@map("contributor_decision_type")
}

enum HealthSex {
  MALE
  FEMALE

  @@map("health_sex")
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE

  @@map("activity_level")
}

enum HealthDataSource {
  MANUAL

  @@map("health_data_source")
}

enum DietPattern {
  VEGAN
  LACTO_OVO

  @@map("diet_pattern")
}

enum PracticeSchedule {
  PERMANENT
  PERIODIC

  @@map("practice_schedule")
}

enum Tradition {
  NONE
  BUDDHIST
  CHRISTIAN

  @@map("tradition")
}

enum DietRuleSource {
  DIET_PATTERN
  TRADITION

  @@map("diet_rule_source")
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE

  @@map("allergy_severity")
}

enum CatalogStatus {
  ACTIVE
  ARCHIVED

  @@map("catalog_status")
}

enum CategoryType {
  FOOD_TYPE
  RECIPE_GROUP
  CONTENT_TOPIC

  @@map("category_type")
}

enum CategoryProposalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("category_proposal_status")
}

enum FoodGroup {
  GRAINS
  LEGUMES
  VEGETABLES
  FRUITS
  NUTS_SEEDS
  MUSHROOMS
  DAIRY_EGGS
  HERBS_SPICES
  OTHER

  @@map("food_group")
}

enum PostType {
  RECIPE
  BLOG
  VIDEO

  @@map("post_type")
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  FLAGGED
  QUARANTINED
  REJECTED
  HIDDEN
  DELETED

  @@map("post_status")
}

enum PostRevisionStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  FLAGGED
  QUARANTINED
  REJECTED

  @@map("post_revision_status")
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD

  @@map("recipe_difficulty")
}

enum IngredientResolutionStatus {
  EXACT
  AMBIGUOUS
  UNKNOWN

  @@map("ingredient_resolution_status")
}

enum MediaKind {
  COVER_IMAGE
  VIDEO

  @@map("media_kind")
}

enum MediaProvider {
  CLOUDINARY
  YOUTUBE

  @@map("media_provider")
}

enum StorageReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED

  @@map("storage_reservation_status")
}

enum MediaAssetStatus {
  ACTIVE
  DELETING
  DELETED
  PROVIDER_MISSING

  @@map("media_asset_status")
}

enum MediaResourceType {
  IMAGE
  VIDEO

  @@map("media_resource_type")
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED

  @@map("comment_status")
}

enum CommunityAction {
  COMMENT_CREATE
  COMMENT_EDIT
  VOTE
  RATING
  BOOKMARK

  @@map("community_action")
}

enum ReportTargetType {
  POST
  COMMENT

  @@map("report_target_type")
}

enum ReportStatus {
  OPEN
  RESOLVED

  @@map("report_status")
}

enum ModerationPriority {
  NORMAL
  HIGH

  @@map("moderation_priority")
}

enum AiFlagRiskLevel {
  LOW
  MEDIUM
  HIGH

  @@map("ai_flag_risk_level")
}

enum AiFlagStatus {
  OPEN
  REVIEWED

  @@map("ai_flag_status")
}

enum ModerationTargetType {
  POST
  COMMENT
  USER
  REPORT
  AI_FLAG

  @@map("moderation_target_type")
}

enum ModerationDecision {
  APPROVE
  REJECT
  NO_VIOLATION
  WARN
  HIDE
  RESTORE
  DEMOTE
  BAN
  UNBAN
  LOCK
  UNLOCK
  DELETE_ACCOUNT

  @@map("moderation_decision")
}

enum BehaviorEventType {
  SEARCH
  VIEW_RECIPE
  BOOKMARK
  RATE
  CHAT_TOPIC
  ACCEPT_MEAL
  SWAP_MEAL
  REJECT_MEAL

  @@map("behavior_event_type")
}

enum MealGoal {
  MAINTAIN
  LOSE
  GAIN

  @@map("meal_goal")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER

  @@map("meal_type")
}

enum MealSlotStatus {
  FILLED
  UNFILLED

  @@map("meal_slot_status")
}

enum NutritionDataQuality {
  COMPLETE
  PARTIAL
  UNAVAILABLE

  @@map("nutrition_data_quality")
}

enum MealPlanMutationType {
  SWAP

  @@map("meal_plan_mutation_type")
}

enum ChatMessageRole {
  USER
  ASSISTANT

  @@map("chat_message_role")
}

enum ChatMessageStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("chat_message_status")
}

enum ChatFeedbackValue {
  UP
  DOWN

  @@map("chat_feedback_value")
}

enum AiRequestStatus {
  IN_PROGRESS
  SUCCESS
  FALLBACK
  BLOCKED
  FAILED
  ABORTED

  @@map("ai_request_status")
}

enum FoodDataProvider {
  USDA_FDC
  VIETNAM_CURATED
  OPEN_FOOD_FACTS
  MANUAL
  AI_SUGGESTION

  @@map("food_data_provider")
}

enum FoodDataReviewStatus {
  STAGED
  APPROVED
  REJECTED
  SUPERSEDED

  @@map("food_data_review_status")
}

enum FoodDataQuality {
  VERIFIED
  REVIEWED
  ESTIMATED
  INCOMPLETE

  @@map("food_data_quality")
}

enum FoodDataImportStatus {
  PREVIEWED
  COMMITTED
  FAILED

  @@map("food_data_import_status")
}

enum UnitDimension {
  MASS
  VOLUME
  ENERGY
  COUNT
  PROPORTION

  @@map("unit_dimension")
}

enum NutrientReferenceType {
  RDA
  AI
  UL
  DV
  OTHER

  @@map("nutrient_reference_type")
}

enum EvidenceGrade {
  HIGH
  MODERATE
  LOW
  INSUFFICIENT

  @@map("evidence_grade")
}

enum FoodRuleSeverity {
  INFO
  CAUTION
  HIGH

  @@map("food_rule_severity")
}

enum GuidelinePeriod {
  MEAL
  DAY
  WEEK

  @@map("guideline_period")
}

enum InteractionScope {
  SAME_DISH
  SAME_MEAL
  SAME_DAY

  @@map("interaction_scope")
}

enum InteractionDirection {
  BENEFICIAL
  ADVERSE

  @@map("interaction_direction")
}

enum FoodDataSuggestionType {
  INGREDIENT_MAPPING
  NUTRIENT_VALUE
  REFERENCE_INTAKE
  HOUSEHOLD_CONVERSION
  RETENTION_FACTOR
  YIELD_FACTOR
  INTERACTION_RULE

  @@map("food_data_suggestion_type")
}

enum NutritionValueOrigin {
  CANONICAL_CALCULATED
  AI_ESTIMATED
  USER_PROVIDED
  VERIFIED_OVERRIDE

  @@map("nutrition_value_origin")
}

enum RecipeNutritionEstimateStatus {
  CURRENT
  HISTORICAL
  STALE

  @@map("recipe_nutrition_estimate_status")
}

model User {
  id                             String                     @id @default(uuid()) @db.Uuid
  email                          String                     @unique @db.VarChar(320)
  passwordHash                   String                     @map("password_hash")
  displayName                    String                     @map("display_name") @db.VarChar(100)
  avatarUrl                      String?                    @map("avatar_url") @db.VarChar(2048)
  role                           Role                       @default(MEMBER)
  status                         UserStatus                 @default(ACTIVE)
  failedLoginAttempts            Int                        @default(0) @map("failed_login_attempts")
  lockedUntil                    DateTime?                  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt                    DateTime?                  @map("last_login_at") @db.Timestamptz(3)
  createdAt                      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                      DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  privateDataPurgeAt             DateTime?                  @map("private_data_purge_at") @db.Timestamptz(3)
  refreshSessions                RefreshSession[]
  applications                   ContributorApplication[]
  reviewedApplications           ContributorApplication[]   @relation("ContributorApplicationReviewer")
  invitedContributorApplications ContributorApplication[]   @relation("ContributorApplicationInviter")
  contributorProfile             ContributorProfile?        @relation("ContributorProfileUser")
  approvedContributorProfiles    ContributorProfile[]       @relation("ContributorProfileApprover")
  revokedContributorProfiles     ContributorProfile[]       @relation("ContributorProfileRevoker")
  contributorDecisions           ContributorDecision[]      @relation("ContributorDecisionSubject")
  madeContributorDecisions       ContributorDecision[]      @relation("ContributorDecisionActor")
  healthProfile                  HealthProfile?
  dietPreference                 DietPreference?
  dietPreferenceRules            DietPreferenceRule[]
  dietScheduleDates              DietScheduleDate[]
  allergies                      UserAllergy[]
  ingredientExclusions           UserIngredientExclusion[]
  categoryProposals              CategoryProposal[]         @relation("CategoryProposalAuthor")
  reviewedCategoryProposals      CategoryProposal[]         @relation("CategoryProposalReviewer")
  posts                          Post[]                     @relation("PostAuthor")
  deletedPosts                   Post[]                     @relation("PostDeletedBy")
  postRevisions                  PostRevision[]             @relation("PostRevisionAuthor")
  comments                       Comment[]                  @relation("CommentAuthor")
  hiddenComments                 Comment[]                  @relation("CommentHiddenBy")
  postVotes                      PostVote[]
  postRatings                    PostRating[]
  postBookmarks                  PostBookmark[]
  communityRateLimits            CommunityRateLimitBucket[]
  reports                        Report[]                   @relation("ReportReporter")
  resolvedReports                Report[]                   @relation("ReportResolver")
  reviewedAiFlags                AiFlag[]                   @relation("AiFlagReviewer")
  moderationActions              ModerationAction[]         @relation("ModerationActor")
  reviewedPostRevisions          PostRevision[]             @relation("PostRevisionReviewer")
  hiddenPosts                    Post[]                     @relation("PostHiddenBy")
  personalizationPreference      PersonalizationPreference?
  behaviorEvents                 BehaviorEvent[]
  mealPlans                      MealPlan[]
  mealPlanMutations              MealPlanMutation[]
  chatSessions                   ChatSession[]
  aiRequestLogs                  AiRequestLog[]
  storageAccount                 StorageAccount?
  mediaAssets                    MediaAsset[]                 @relation("MediaAssetOwner")
  deletedMediaAssets             MediaAsset[]                 @relation("MediaAssetDeletedBy")
  storageAdjustments             StorageAdjustment[]          @relation("StorageAdjustmentSubject")
  madeStorageAdjustments         StorageAdjustment[]          @relation("StorageAdjustmentActor")
  updatedStoragePolicies         StoragePolicy[]               @relation("StoragePolicyUpdater")

  @@map("users")
}

model Category {
  id                String             @id @default(uuid()) @db.Uuid
  parentId          String?            @map("parent_id") @db.Uuid
  name              String             @db.VarChar(120)
  slug              String             @db.VarChar(140)
  type              CategoryType
  status            CatalogStatus      @default(ACTIVE)
  sortOrder         Int                @default(0) @map("sort_order")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent            Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[]         @relation("CategoryTree")
  childProposals    CategoryProposal[] @relation("CategoryProposalParent")
  resolvedProposals CategoryProposal[] @relation("CategoryProposalResolution")
  postCategories    PostCategory[]

  @@index([type, parentId, status, sortOrder])
  @@map("categories")
}

model CategoryProposal {
  id                 String                 @id @default(uuid()) @db.Uuid
  proposedById       String                 @map("proposed_by_id") @db.Uuid
  parentId           String?                @map("parent_id") @db.Uuid
  name               String                 @db.VarChar(120)
  slug               String                 @db.VarChar(140)
  type               CategoryType
  status             CategoryProposalStatus @default(PENDING)
  reviewNote         String?                @map("review_note") @db.VarChar(1000)
  reviewedById       String?                @map("reviewed_by_id") @db.Uuid
  resolvedCategoryId String?                @map("resolved_category_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  proposedBy         User                   @relation("CategoryProposalAuthor", fields: [proposedById], references: [id], onDelete: Cascade)
  parent             Category?              @relation("CategoryProposalParent", fields: [parentId], references: [id], onDelete: Restrict)
  reviewedBy         User?                  @relation("CategoryProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolvedCategory   Category?              @relation("CategoryProposalResolution", fields: [resolvedCategoryId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([proposedById, status])
  @@map("category_proposals")
}

model Ingredient {
  id                    String                        @id @default(uuid()) @db.Uuid
  canonicalName         String                        @map("canonical_name") @db.VarChar(160)
  normalizedName        String                        @unique @map("normalized_name") @db.VarChar(160)
  foodGroup             FoodGroup                     @map("food_group")
  status                CatalogStatus                 @default(ACTIVE)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  aliases               IngredientAlias[]
  allergens             IngredientAllergen[]
  dietCompatibilities   IngredientDietCompatibility[]
  traditionWarnings     IngredientTraditionWarning[]
  userExclusions        UserIngredientExclusion[]
  recipeIngredients     RecipeIngredient[]
  mealPlanShoppingItems MealPlanShoppingItem[]
  foodProfiles          IngredientFoodProfile[]
  intakeGuidelines      IngredientIntakeGuideline[]
  cookingYieldFactors   CookingYieldFactor[]
  interactionRulesA     IngredientInteractionRule[]   @relation("InteractionIngredientA")
  interactionRulesB     IngredientInteractionRule[]   @relation("InteractionIngredientB")
  nutritionLines        RecipeNutritionEstimateLine[]

  @@index([status, foodGroup, canonicalName])
  @@map("ingredients")
}

model Post {
  id                  String         @id @default(uuid()) @db.Uuid
  authorId            String         @map("author_id") @db.Uuid
  type                PostType
  slug                String         @unique @db.VarChar(220)
  status              PostStatus     @default(PENDING_REVIEW)
  version             Int            @default(1)
  publishedRevisionId String?        @unique @map("published_revision_id") @db.Uuid
  publishedAt         DateTime?      @map("published_at") @db.Timestamptz(3)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(3)
  deletedById         String?        @map("deleted_by_id") @db.Uuid
  hiddenAt            DateTime?      @map("hidden_at") @db.Timestamptz(3)
  hiddenById          String?        @map("hidden_by_id") @db.Uuid
  hiddenReason        String?        @map("hidden_reason") @db.VarChar(1000)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  author              User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedBy           User?          @relation("PostDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  hiddenBy            User?          @relation("PostHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  revisions           PostRevision[] @relation("PostRevisions")
  publishedRevision   PostRevision?  @relation("PublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  comments            Comment[]
  votes               PostVote[]
  ratings             PostRating[]
  bookmarks           PostBookmark[]
  mealPlanItems       MealPlanItem[]

  @@index([status, type, publishedAt])
  @@index([authorId, status, updatedAt])
  @@map("posts")
}

model Comment {
  id           String        @id @default(uuid()) @db.Uuid
  postId       String        @map("post_id") @db.Uuid
  authorId     String        @map("author_id") @db.Uuid
  parentId     String?       @map("parent_id") @db.Uuid
  content      String        @db.VarChar(2000)
  status       CommentStatus @default(VISIBLE)
  editedAt     DateTime?     @map("edited_at") @db.Timestamptz(3)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(3)
  hiddenAt     DateTime?     @map("hidden_at") @db.Timestamptz(3)
  hiddenById   String?       @map("hidden_by_id") @db.Uuid
  hiddenReason String?       @map("hidden_reason") @db.VarChar(1000)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author       User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies      Comment[]     @relation("CommentReplies")
  hiddenBy     User?         @relation("CommentHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([postId, status, createdAt, id])
  @@index([parentId, status, createdAt, id])
  @@index([authorId, status, createdAt])
  @@map("comments")
}

model PostVote {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, createdAt])
  @@map("post_votes")
}

model PostRating {
  userId     String   @map("user_id") @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  taste      Int
  difficulty Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, active])
  @@map("post_ratings")
}

model PostBookmark {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, createdAt])
  @@index([userId, createdAt, postId])
  @@map("post_bookmarks")
}

model CommunityRateLimitBucket {
  userId      String          @map("user_id") @db.Uuid
  action      CommunityAction
  windowStart DateTime        @map("window_start") @db.Timestamptz(0)
  count       Int             @default(1)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, action, windowStart])
  @@index([windowStart])
  @@map("community_rate_limit_buckets")
}

model PostRevision {
  id                String                    @id @default(uuid()) @db.Uuid
  postId            String                    @map("post_id") @db.Uuid
  version           Int
  status            PostRevisionStatus        @default(PENDING_REVIEW)
  title             String                    @db.VarChar(200)
  normalizedTitle   String                    @map("normalized_title") @db.VarChar(200)
  excerpt           String?                   @db.VarChar(500)
  normalizedExcerpt String?                   @map("normalized_excerpt") @db.VarChar(500)
  body              String
  normalizedBody    String                    @map("normalized_body")
  createdById       String                    @map("created_by_id") @db.Uuid
  reviewNote        String?                   @map("review_note") @db.VarChar(2000)
  reviewedById      String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?                 @map("reviewed_at") @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  post              Post                      @relation("PostRevisions", fields: [postId], references: [id], onDelete: Cascade)
  createdBy         User                      @relation("PostRevisionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy        User?                     @relation("PostRevisionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  aiFlags           AiFlag[]
  publishedFor      Post?                     @relation("PublishedRevision")
  recipeDetail      RecipeDetail?
  ingredients       RecipeIngredient[]
  recipeSteps       RecipeStep[]
  nutritionEstimates RecipeNutritionEstimate[]
  nutritionAiJobs   RecipeNutritionAiJob[]
  dietCompatibility RecipeDietCompatibility[]
  categories        PostCategory[]
  tags              PostTag[]
  media             PostMedia[]
  mealPlanItems     MealPlanItem[]

  @@unique([postId, version])
  @@index([postId, status, createdAt])
  @@index([normalizedTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "post_revisions_normalized_title_trgm_idx")
  @@index([normalizedBody(ops: raw("gin_trgm_ops"))], type: Gin, map: "post_revisions_normalized_body_trgm_idx")
  @@map("post_revisions")
}

model Report {
  id               String              @id @default(uuid()) @db.Uuid
  reporterId       String              @map("reporter_id") @db.Uuid
  targetType       ReportTargetType    @map("target_type")
  targetId         String              @map("target_id") @db.Uuid
  reasonCode       String              @map("reason_code") @db.VarChar(120)
  details          String?             @db.VarChar(2000)
  status           ReportStatus        @default(OPEN)
  priority         ModerationPriority  @default(NORMAL)
  activeKey        String?             @unique @map("active_key") @db.VarChar(160)
  resolvedDecision ModerationDecision? @map("resolved_decision")
  resolvedReason   String?             @map("resolved_reason") @db.VarChar(2000)
  resolvedById     String?             @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  reporter         User                @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy       User?               @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, status, createdAt])
  @@index([status, priority, createdAt])
  @@index([reporterId, status, createdAt])
  @@map("reports")
}

model AiFlag {
  id             String          @id @default(uuid()) @db.Uuid
  postRevisionId String          @map("post_revision_id") @db.Uuid
  provider       String          @db.VarChar(80)
  model          String          @db.VarChar(120)
  ruleVersion    String          @map("rule_version") @db.VarChar(40)
  reasonCodes    Json            @map("reason_codes")
  riskScore      Decimal         @map("risk_score") @db.Decimal(5, 4)
  riskLevel      AiFlagRiskLevel @map("risk_level")
  status         AiFlagStatus    @default(OPEN)
  reviewedById   String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  postRevision   PostRevision    @relation(fields: [postRevisionId], references: [id], onDelete: Cascade)
