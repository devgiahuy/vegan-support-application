model User {
  referenceVersion               Int                         @default(0) @map("reference_version")
  lockVersion                    Int                         @default(0) @map("lock_version")
  id                             String                      @id @default(uuid()) @map("_id")
  email                          String                      @unique
  passwordHash                   String                      @map("password_hash")
  displayName                    String                      @map("display_name")
  avatarUrl                      String?                     @map("avatar_url")
  role                           Role                        @default(MEMBER)
  status                         UserStatus                  @default(ACTIVE)
  failedLoginAttempts            Int                         @default(0) @map("failed_login_attempts")
  lockedUntil                    DateTime?                   @map("locked_until")
  lastLoginAt                    DateTime?                   @map("last_login_at")
  createdAt                      DateTime                    @default(now()) @map("created_at")
  updatedAt                      DateTime                    @updatedAt @map("updated_at")
  deletedAt                      DateTime?                   @map("deleted_at")
  privateDataPurgeAt             DateTime?                   @map("private_data_purge_at")
  refreshSessions                RefreshSession[]
  applications                   ContributorApplication[]
  reviewedApplications           ContributorApplication[]    @relation("ContributorApplicationReviewer")
  invitedContributorApplications ContributorApplication[]    @relation("ContributorApplicationInviter")
  contributorProfile             ContributorProfile?         @relation("ContributorProfileUser")
  approvedContributorProfiles    ContributorProfile[]        @relation("ContributorProfileApprover")
  revokedContributorProfiles     ContributorProfile[]        @relation("ContributorProfileRevoker")
  contributorDecisions           ContributorDecision[]       @relation("ContributorDecisionSubject")
  madeContributorDecisions       ContributorDecision[]       @relation("ContributorDecisionActor")
  healthProfile                  HealthProfile?
  dietPreference                 DietPreference?
  dietPreferenceRules            DietPreferenceRule[]
  dietScheduleDates              DietScheduleDate[]
  allergies                      UserAllergy[]
  ingredientExclusions           UserIngredientExclusion[]
  categoryProposals              CategoryProposal[]          @relation("CategoryProposalAuthor")
  reviewedCategoryProposals      CategoryProposal[]          @relation("CategoryProposalReviewer")
  posts                          Post[]                      @relation("PostAuthor")
  deletedPosts                   Post[]                      @relation("PostDeletedBy")
  postRevisions                  PostRevision[]              @relation("PostRevisionAuthor")
  comments                       Comment[]                   @relation("CommentAuthor")
  hiddenComments                 Comment[]                   @relation("CommentHiddenBy")
  postVotes                      PostVote[]
  postRatings                    PostRating[]
  postBookmarks                  PostBookmark[]
  communityRateLimits            CommunityRateLimitBucket[]
  reports                        Report[]                    @relation("ReportReporter")
  resolvedReports                Report[]                    @relation("ReportResolver")
  reviewedAiFlags                AiFlag[]                    @relation("AiFlagReviewer")
  moderationActions              ModerationAction[]          @relation("ModerationActor")
  reviewedPostRevisions          PostRevision[]              @relation("PostRevisionReviewer")
  hiddenPosts                    Post[]                      @relation("PostHiddenBy")
  personalizationPreference      PersonalizationPreference?
  behaviorEvents                 BehaviorEvent[]
  mealPlans                      MealPlan[]
  mealPlanMutations              MealPlanMutation[]
  chatSessions                   ChatSession[]
  aiRequestLogs                  AiRequestLog[]
  storageAccount                 StorageAccount?
  mediaAssets                    MediaAsset[]                @relation("MediaAssetOwner")
  deletedMediaAssets             MediaAsset[]                @relation("MediaAssetDeletedBy")
  storageAdjustments             StorageAdjustment[]         @relation("StorageAdjustmentSubject")
  madeStorageAdjustments         StorageAdjustment[]         @relation("StorageAdjustmentActor")
  updatedStoragePolicies         StoragePolicy[]             @relation("StoragePolicyUpdater")
  customMeals                    CustomMeal[]
  mealPrograms                   MealProgram[]
  mealProgramMutations           MealProgramMutation[]
  pantryItems                    PantryItem[]
  pantryAdjustments              PantryAdjustment[]
  recognitionJobs                RecognitionJob[]
  receiptJobs                    ReceiptJob[]
  aiArtifacts                    AiArtifact[]                @relation("AiArtifactOwner")
  aiVerifications                AiVerification[]            @relation("AiVerificationReviewer")
  aiVerificationAdminActions     AiVerificationAdminAction[] @relation("AiVerificationAdminActor")
  submittedRestaurants           Restaurant[]                @relation("RestaurantSubmitter")
  reviewedRestaurants            Restaurant[]                @relation("RestaurantReviewer")
  restaurantAuditEvents          RestaurantAudit[]           @relation("RestaurantAuditActor")
  notifications                  Notification[]

  @@map("users")
}

model Notification {
  referenceVersion Int       @default(0) @map("reference_version")
  id               String    @id @default(uuid()) @map("_id")
  ownerId          String    @map("owner_id")
  type             String
  title            String
  summary          String?
  link             String?
  payloadVersion   Int       @default(1) @map("payload_version")
  payload          Json      @default("{}")
  dedupeKey        String    @unique @map("dedupe_key")
  createdAt        DateTime  @default(now()) @map("created_at")
  readAt           DateTime? @map("read_at")
  expiresAt        DateTime  @map("expires_at")
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerId, readAt, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("notifications")
}

model Restaurant {
  referenceVersion    Int                     @default(0) @map("reference_version")
  id                  String                  @id @default(uuid()) @map("_id")
  name                String
  normalizedName      String                  @map("normalized_name")
  address             String
  normalizedAddress   String                  @map("normalized_address")
  latitude            Float
  longitude           Float
  categories          String[]                @default([])
  dietTags            String[]                @default([]) @map("diet_tags")
  allergenFreeCodes   String[]                @default([]) @map("allergen_free_codes")
  excludedIngredients String[]                @default([]) @map("excluded_ingredients")
  source              RestaurantSource
  status              RestaurantStatus        @default(PENDING)
  submitterId         String?                 @map("submitter_id")
  reviewerId          String?                 @map("reviewer_id")
  reviewedAt          DateTime?               @map("reviewed_at")
  reviewReason        String?                 @map("review_reason")
  dataCheckedAt       DateTime?               @map("data_checked_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  submitter           User?                   @relation("RestaurantSubmitter", fields: [submitterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer            User?                   @relation("RestaurantReviewer", fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  externalRefs        RestaurantExternalRef[]
  auditEvents         RestaurantAudit[]

  @@index([status, latitude, longitude])
  @@index([normalizedName, normalizedAddress])
  @@index([submitterId, status])
  @@map("restaurants")
}

model RestaurantExternalRef {
  referenceVersion Int        @default(0) @map("reference_version")
  id               String     @id @default(uuid()) @map("_id")
  restaurantId     String     @map("restaurant_id")
  provider         String
  placeId          String     @map("place_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([provider, placeId])
  @@index([restaurantId])
  @@map("restaurant_external_refs")
}

model RestaurantProviderPlace {
  referenceVersion Int      @default(0) @map("reference_version")
  id               String   @id @default(uuid()) @map("_id")
  provider         String
  placeId          String   @map("place_id")
  name             String
  address          String
  latitude         Float
  longitude        Float
  categories       String[] @default([])
  rating           Float?
  reviewCount      Int?     @map("review_count")
  price            String?
  openState        String?  @map("open_state")
  operatingHours   Json?    @map("operating_hours")
  phone            String?
  website          String?
  thumbnailUrl     String?  @map("thumbnail_url")
  mapsUrl          String?  @map("maps_url")
  attribution      String
  fetchedAt        DateTime @map("fetched_at")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([provider, placeId])
  @@index([provider, latitude, longitude])
  @@index([expiresAt])
  @@map("restaurant_provider_places")
}

model RestaurantAudit {
  referenceVersion Int        @default(0) @map("reference_version")
  id               String     @id @default(uuid()) @map("_id")
  restaurantId     String     @map("restaurant_id")
  actorId          String     @map("actor_id")
  action           String
  reason           String?
  createdAt        DateTime   @default(now()) @map("created_at")
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor            User       @relation("RestaurantAuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([restaurantId, createdAt])
  @@map("restaurant_audit")
}

model Category {
  referenceVersion  Int                @default(0) @map("reference_version")
  id                String             @id @default(uuid()) @map("_id")
  parentId          String?            @map("parent_id")
  name              String
  slug              String
  type              CategoryType
  status            CatalogStatus      @default(ACTIVE)
  sortOrder         Int                @default(0) @map("sort_order")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  parent            Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Category[]         @relation("CategoryTree")
  childProposals    CategoryProposal[] @relation("CategoryProposalParent")
  resolvedProposals CategoryProposal[] @relation("CategoryProposalResolution")
  postCategories    PostCategory[]

  @@index([type, parentId, status, sortOrder])
  @@map("categories")
}

model CategoryProposal {
  referenceVersion   Int                    @default(0) @map("reference_version")
  id                 String                 @id @default(uuid()) @map("_id")
  proposedById       String                 @map("proposed_by_id")
  parentId           String?                @map("parent_id")
  name               String
  slug               String
  type               CategoryType
  status             CategoryProposalStatus @default(PENDING)
  reviewNote         String?                @map("review_note")
  reviewedById       String?                @map("reviewed_by_id")
  resolvedCategoryId String?                @map("resolved_category_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  proposedBy         User                   @relation("CategoryProposalAuthor", fields: [proposedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent             Category?              @relation("CategoryProposalParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy         User?                  @relation("CategoryProposalReviewer", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedCategory   Category?              @relation("CategoryProposalResolution", fields: [resolvedCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, createdAt])
  @@index([proposedById, status])
  @@map("category_proposals")
}

model Ingredient {
  referenceVersion      Int                           @default(0) @map("reference_version")
  id                    String                        @id @default(uuid()) @map("_id")
  canonicalName         String                        @map("canonical_name")
  normalizedName        String                        @unique @map("normalized_name")
  foodGroup             FoodGroup                     @map("food_group")
  status                CatalogStatus                 @default(ACTIVE)
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")
  aliases               IngredientAlias[]
  allergens             IngredientAllergen[]
  dietCompatibilities   IngredientDietCompatibility[]
  traditionWarnings     IngredientTraditionWarning[]
  userExclusions        UserIngredientExclusion[]
  recipeIngredients     RecipeIngredient[]
  mealPlanShoppingItems MealPlanShoppingItem[]
  foodProfiles          IngredientFoodProfile[]
  intakeGuidelines      IngredientIntakeGuideline[]
  cookingYieldFactors   CookingYieldFactor[]
  interactionRulesA     IngredientInteractionRule[]   @relation("InteractionIngredientA")
  interactionRulesB     IngredientInteractionRule[]   @relation("InteractionIngredientB")
  nutritionLines        RecipeNutritionEstimateLine[]
  customMealIngredients CustomMealIngredient[]
  pantryItems           PantryItem[]
  recognitionCandidates RecognitionCandidate[]
  receiptCandidates     ReceiptCandidate[]

  @@index([status, foodGroup, canonicalName])
  @@map("ingredients")
}

model PantryItem {
  referenceVersion        Int                      @default(0) @map("reference_version")
  id                      String                   @id @default(uuid()) @map("_id")
  ownerId                 String                   @map("owner_id")
  ingredientId            String?                  @map("ingredient_id")
  unmatchedText           String?                  @map("unmatched_text")
  normalizedUnmatchedText String?                  @map("normalized_unmatched_text")
  quantity                Float
  unit                    String
  normalizedGrams         Float?                   @map("normalized_grams")
  conversionStatus        PantryConversionStatus   @map("conversion_status")
  conversionSource        String?                  @map("conversion_source")
  conversionVersion       String?                  @map("conversion_version")
  conversionConfidence    Float?                   @map("conversion_confidence")
  source                  PantryItemSource
  sourceReferenceId       String?                  @map("source_reference_id")
  confidence              Float                    @default(1)
  confirmationStatus      PantryConfirmationStatus @default(CONFIRMED) @map("confirmation_status")
  purchasedAt             DateTime?                @map("purchased_at")
  openedAt                DateTime?                @map("opened_at")
  expiresAt               DateTime?                @map("expires_at")
  freshnessNote           String?                  @map("freshness_note")
  version                 Int                      @default(1)
  deletedAt               DateTime?                @map("deleted_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  owner                   User                     @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingredient              Ingredient?              @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adjustments             PantryAdjustment[]       @relation("PantryItemAdjustments")
  mergedIntoAdjustments   PantryAdjustment[]       @relation("PantryMergedIntoAdjustments")
  recognitionCandidates   RecognitionCandidate[]
  receiptCandidates       ReceiptCandidate[]

  @@index([ownerId, deletedAt, confirmationStatus, updatedAt])
  @@index([ownerId, ingredientId, deletedAt])
  @@index([ownerId, normalizedUnmatchedText, deletedAt])
  @@index([ownerId, expiresAt, deletedAt])
  @@map("pantry_items")
}

model PantryAdjustment {
  referenceVersion     Int                  @default(0) @map("reference_version")
  id                   String               @id @default(uuid()) @map("_id")
  ownerId              String               @map("owner_id")
  pantryItemId         String               @map("pantry_item_id")
  type                 PantryAdjustmentType
  idempotencyKey       String               @map("idempotency_key")
  requestHash          String               @map("request_hash")
  inputQuantity        Float                @map("input_quantity")
  inputUnit            String               @map("input_unit")
  appliedDeltaQuantity Float                @map("applied_delta_quantity")
  normalizedDeltaGrams Float?               @map("normalized_delta_grams")
  beforeQuantity       Float                @map("before_quantity")
  afterQuantity        Float                @map("after_quantity")
  beforeGrams          Float?               @map("before_grams")
  afterGrams           Float?               @map("after_grams")
  versionBefore        Int                  @map("version_before")
  versionAfter         Int                  @map("version_after")
  reason               String?
  mergedFromItemId     String?              @map("merged_from_item_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pantryItem           PantryItem           @relation("PantryItemAdjustments", fields: [pantryItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mergedFromItem       PantryItem?          @relation("PantryMergedIntoAdjustments", fields: [mergedFromItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([ownerId, idempotencyKey])
  @@index([pantryItemId, createdAt, id])
  @@index([ownerId, createdAt, id])
  @@map("pantry_adjustments")
}

model RecognitionJob {
  referenceVersion      Int                    @default(0) @map("reference_version")
  id                    String                 @id @default(uuid()) @map("_id")
  ownerId               String                 @map("owner_id")
  status                RecognitionJobStatus   @default(QUEUED)
  provider              String
  modelId               String                 @map("model_id")
  templateVersion       String                 @map("template_version")
  idempotencyKey        String                 @map("idempotency_key")
  requestHash           String                 @map("request_hash")
  attemptCount          Int                    @default(0) @map("attempt_count")
  errorCode             String?                @map("error_code")
