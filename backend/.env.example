NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vegan:vegan_local@localhost:5432/vegan_support?schema=public
FRONTEND_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=vegan-support-api
JWT_AUDIENCE=vegan-support-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_UPLOAD_FOLDER=vegan-support/posts
MAX_UPLOAD_IMAGE_BYTES=10000000
MAX_UPLOAD_VIDEO_BYTES=100000000

# Seed passwords are required only when running `npm run seed`.
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=replace-with-a-local-member-password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password
