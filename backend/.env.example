NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vegan:vegan_local@localhost:5432/vegan_support?schema=public
FRONTEND_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=vegan-support-api
JWT_AUDIENCE=vegan-support-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_UPLOAD_FOLDER=vegan-support/posts
MAX_UPLOAD_IMAGE_BYTES=10000000
MAX_UPLOAD_VIDEO_BYTES=100000000
STORAGE_DEFAULT_QUOTA_BYTES=1073741824
UPLOAD_RESERVATION_TTL_SECONDS=900
CLOUDINARY_API_TIMEOUT_MS=10000
MEAL_PLAN_MAINTAIN_FACTOR=1
MEAL_PLAN_LOSE_FACTOR=0.9
MEAL_PLAN_GAIN_FACTOR=1.1
MEAL_PROGRAM_MAX_WEEKS=12
MEAL_PROGRAM_MAX_ALTERNATIVES_PER_WEEK=3
MEAL_PROGRAM_MAX_REGENERATIONS_PER_WEEK=2
AI_CHAT_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL_CHAT=gpt-5.6-terra
AI_MODEL_MODERATION=omni-moderation-latest
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=800
AI_GUEST_DAILY_QUOTA=5
AI_MEMBER_DAILY_QUOTA=20
AI_PRIVILEGED_DAILY_QUOTA=50
AI_GUEST_RATE_LIMIT_PER_MINUTE=10
CHAT_GUEST_COOKIE_SECRET=replace-with-at-least-32-random-characters
CHAT_GUEST_COOKIE_TTL_DAYS=7

# Seed passwords are required only when running `npm run seed`.
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=replace-with-a-local-member-password
SEED_PLATFORM_CONTRIBUTOR_EMAIL=contributor@example.com
SEED_ORGANIZATION_CONTRIBUTOR_EMAIL=expert@example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password
