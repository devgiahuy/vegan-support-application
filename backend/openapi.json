{
  "openapi": "3.1.0",
  "info": {
    "title": "Vegan Support Application API",
    "version": "0.1.0",
    "description": "REST API contract for the Vegan Support Application."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Foundation",
      "description": "Service health and foundation contract"
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ok"
                ]
              },
              "database": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "up"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              "environment": {
                "type": "string",
                "enum": [
                  "development",
                  "test",
                  "production"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "uptimeSeconds": {
                "type": "number",
                "minimum": 0
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "database",
              "environment",
              "timestamp",
              "uptimeSeconds",
              "requestId"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "null"
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "HealthUnavailableResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "DATABASE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "object",
                "properties": {
                  "database": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "down"
                      ]
                    }
                  }
                },
                "required": [
                  "database"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "message",
              "fields",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Foundation"
        ],
        "summary": "Kiểm tra trạng thái API và PostgreSQL",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "API và PostgreSQL hoạt động bình thường",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL không khả dụng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailableResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
