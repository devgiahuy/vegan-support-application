{
  "expo": {
    "name": "VeggieConnect",
    "slug": "veggieconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.veggieconnect.mobile"
    },
    "android": {
      "package": "vn.veggieconnect.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F1F8E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#0B1410",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép VeggieConnect chọn ảnh từ thư viện của bạn.",
          "cameraPermission": "Cho phép VeggieConnect dùng camera để chụp ảnh đại diện, ảnh bìa bài đăng, ảnh món ăn và quét tủ lạnh hoặc hóa đơn.",
          "microphonePermission": "Cho phép VeggieConnect dùng micro khi bạn quay video nấu ăn để đăng lên."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cho phép VeggieConnect truy cập vị trí để tìm quán chay gần bạn."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6efabf50-9e97-4da9-ae4f-ac9ac36b9209"
      }
    },
    "owner": "huypg",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6efabf50-9e97-4da9-ae4f-ac9ac36b9209"
    }
  }
}
