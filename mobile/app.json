{
  "expo": {
    "name": "VeggieConnect",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.veggieconnect.mobile"
    },
    "android": {
      "package": "vn.veggieconnect.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F1F8E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#0B1410",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép VeggieConnect chọn ảnh từ thư viện của bạn.",
          "cameraPermission": "Cho phép VeggieConnect dùng camera để chụp ảnh đại diện, ảnh bìa bài đăng, ảnh món ăn và quét tủ lạnh hoặc hóa đơn.",
          "microphonePermission": "Cho phép VeggieConnect dùng micro khi bạn quay video nấu ăn để đăng lên."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cho phép VeggieConnect truy cập vị trí để tìm quán chay gần bạn."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
