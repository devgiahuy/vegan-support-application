# Copy file này thành `.env` rồi điền giá trị phù hợp với cách bạn test (`.env` đã bị gitignore).
# Sau khi đổi `.env` phải chạy lại `npx expo start -c` vì biến EXPO_PUBLIC_* được nhúng lúc bundle.
# Xem thêm mô tả ở mobile/src/lib/env.ts.

# BẮT BUỘC — base URL backend, kết thúc bằng /api/v1:
#   Android Emulator:      http://10.0.2.2:<port>/api/v1
#   Thiết bị thật (Wi-Fi): http://<IP-LAN-máy-chạy-backend>:<port>/api/v1
#   iOS Simulator:         http://localhost:<port>/api/v1
EXPO_PUBLIC_API_URL=

# Tuỳ chọn — ảnh dự phòng khi nội dung không có ảnh bìa (để trống = không hiện ảnh dự phòng).
EXPO_PUBLIC_FALLBACK_RECIPE_COVER_URL=
EXPO_PUBLIC_FALLBACK_ARTICLE_COVER_URL=
EXPO_PUBLIC_FALLBACK_VIDEO_THUMBNAIL_URL=

# Tuỳ chọn — mẫu URL thumbnail YouTube, giữ nguyên {id} (sẽ được thay bằng ID video).
EXPO_PUBLIC_YOUTUBE_THUMBNAIL_URL_TEMPLATE=

# Tuỳ chọn — mẫu URL chỉ đường, giữ nguyên {lat} và {lng} (để trống = ẩn nút "Chỉ đường").
EXPO_PUBLIC_MAPS_DIRECTIONS_URL_TEMPLATE=

# Tuỳ chọn — email hỗ trợ cho trang Liên hệ / Góp ý (để trống = ẩn nút gửi email).
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_CONTACT_EMAIL=

# Tuỳ chọn — liên kết mạng xã hội ở footer trang chủ (để trống = ẩn nút tương ứng).
EXPO_PUBLIC_SOCIAL_FACEBOOK_URL=
EXPO_PUBLIC_SOCIAL_INSTAGRAM_URL=
EXPO_PUBLIC_SOCIAL_YOUTUBE_URL=
EXPO_PUBLIC_SOCIAL_TIKTOK_URL=
EXPO_PUBLIC_SOCIAL_PINTEREST_URL=
EXPO_PUBLIC_SOCIAL_X_URL=
