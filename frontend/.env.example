# Backend API Base URL (public, dùng cho axios client + rewrites)
NEXT_PUBLIC_API_URL=

# App Base URL
NEXT_PUBLIC_APP_URL=

# Backend URL server-only (ưu tiên cho serverFetch, không lộ ra browser)
# BACKEND_API_URL=

# Google Maps browser key (FE-only theo spec 018; BẮT BUỘC giới hạn HTTP referrer
# theo miền triển khai, KHÔNG commit giá trị thật; thiếu key → dùng provider mock)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Nguồn dữ liệu quán: google | mock (mặc định mock khi thiếu key)
PLACE_PROVIDER=mock